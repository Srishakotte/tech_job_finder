# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# polling (local) or webhook (Render)
TELEGRAM_MODE=polling
# Webhook mode only. Render sets RENDER_EXTERNAL_URL automatically.
WEBHOOK_PATH=telegram-webhook
WEBHOOK_SECRET=

# --- Link shortener ------------------------------------------------------------
TERABOXLINKS_USERNAME=
TERABOXLINKS_PASSWORD=

# --- Instagram publishing ---------------------------------------------------------
INSTA_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Comment-to-DM (Instagram webhook at /instagram/webhook) ---------------------
COMMENT_TO_DM_ENABLED=true
# Word shown on the Reel and caption: "Comment LINK"
COMMENT_KEYWORD=LINK
# any = every comment gets a DM; keyword = only comments containing the keyword(s)
COMMENT_DM_TRIGGER=any
# Extra trigger words when COMMENT_DM_TRIGGER=keyword (comma separated)
COMMENT_DM_KEYWORDS=apply,interested,link
COMMENT_DM_ONCE_PER_USER=true
COMMENT_PUBLIC_REPLY=true
# Optional: replies separated by |
COMMENT_PUBLIC_REPLIES=
# Optional DM template. Placeholders: {username} {role_at_company} {role} {company} {link}
COMMENT_DM_MESSAGE=
# Any random string; paste the same value into the Meta app's webhook settings
META_WEBHOOK_VERIFY_TOKEN=
# Instagram app secret (Meta app dashboard > Instagram > API setup with Instagram login)
META_APP_SECRET=
# Recommended on Render (disk is wiped on restart). Free MongoDB Atlas works.
MONGODB_URI=

# --- Reel look ----------------------------------------------------------------------
# Shown top-right on the card, e.g. @yourpage
BRAND_HANDLE=
# false = static image Reel (default); true = animated version
REEL_MOTION=false
# Put the raw apply link in the caption too (default off: "comment for link" gets more engagement)
CAPTION_INCLUDE_LINK=false
REEL_DURATION_SECONDS=7
LOGO_DEV_TOKEN=

# Optional: only used by the alternate Gemini parser.
GEMINI_API_KEY=
